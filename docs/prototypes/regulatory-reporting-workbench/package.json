{
  "name": "regulatory-reporting-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "serve:lan": "npm run build && python scripts/serve_lan_proxy.py --host 0.0.0.0 --port 8766",
    "test:proxy": "python -m unittest discover -s tests -p test_serve_lan_proxy.py -v",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
